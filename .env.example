# Copy to .env (never commit .env)
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=codeatlas
POSTGRES_PORT=5433
REDIS_PORT=6380

# Host-side URLs (dev, outside Docker). Inside Compose, use service names.
DATABASE_URL=postgres://codeatlas:change-me-locally@127.0.0.1:5433/codeatlas
REDIS_URL=redis://127.0.0.1:6380
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# MCP server (Day 8). Create the read-only role with: MCP_DB_PASSWORD=... npm run admin -w apps/mcp -- setup-role
MCP_DB_PASSWORD=change-me-to-a-long-random-string
MCP_DATABASE_URL=postgres://codeatlas_mcp:change-me-to-a-long-random-string@127.0.0.1:5433/codeatlas
MCP_PORT=4100
